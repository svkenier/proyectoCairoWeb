{
  "name": "petrescue",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "db:clean-test-data": "npx tsx scripts/purge-test-data.ts",
    "deploy:prod": "vercel --prod --yes",
    "deploy:webhook": "npx tsx scripts/deploy-webhook.ts",
    "db:migrate-token-version": "npx tsx scripts/migrate-token-version.ts"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^6.4.8",
    "@mui/material": "^6.4.8",
    "@mui/x-date-pickers": "^7.29.4",
    "@tanstack/react-query": "^5.83.0",
    "@tanstack/react-query-devtools": "^5.83.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.3",
    "axios": "^1.9.0",
    "bcryptjs": "^3.0.3",
    "dayjs": "^1.11.23",
    "formik": "^2.4.9",
    "jsonwebtoken": "^9.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.7.0",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vercel/node": "^10.0.0",
    "@vitejs/plugin-react": "^4.5.1",
    "dotenv": "^17.4.2",
    "oxlint": "^1.79.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  },
  "overrides": {
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7"
  }
