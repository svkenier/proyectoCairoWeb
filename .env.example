# Environment Variables Template
# Copy this file to .env.local and fill in the values

# GitHub Configuration (Required for backend API & frontend CDN)
# GITHUB_TOKEN=""
# GITHUB_OWNER=""
# GITHUB_REPO=""
# GITHUB_BRANCH="main"

# Upstash Redis Configuration (Required for KV storage)
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# Auth Configuration
# Genera un hash con bcrypt para la contraseña del admin
# ADMIN_PASSWORD_HASH=""
# Genera un string aleatorio largo para JWT
# JWT_SECRET=""
# Genera un string para encriptación maestra si es necesaria
# MASTER_RESCUE_KEY=""

# Base URL para SEO dinámico
# VITE_SITE_URL="https://proyecto-cairo.vercel.app"
